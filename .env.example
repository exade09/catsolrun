# Neon pooled connection string. Keep the real value in Vercel project settings or .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional Solana JSON-RPC endpoint used for live Phantom wallet balances.
# Use a dedicated provider in production to avoid public endpoint rate limits.
VITE_SOLANA_RPC_URL=https://api.mainnet.solana.com

# Token mint required for withdrawal eligibility. Leave empty until the CA is published.
VITE_ELIGIBILITY_TOKEN_MINT=
