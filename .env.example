# Neon pooled connection string. Keep the real value in Vercel project settings or .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Overrides the Solana JSON-RPC endpoint used for live Phantom wallet balances.
# A Helius endpoint is compiled in as the default, so this only needs a value to
# point a deployment at a different provider.
VITE_SOLANA_RPC_URL=

# Overrides the eligibility mint. The published MWAVE mint is compiled in as the
# default (src/config/token.ts), so this only needs a value when staging against
# a different token.
VITE_ELIGIBILITY_TOKEN_MINT=
